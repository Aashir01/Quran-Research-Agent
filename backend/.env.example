# Database
QRA_DATABASE_URL=postgresql+psycopg://qra:qra@localhost:5432/qra
QRA_REDIS_URL=redis://localhost:6379/0

# Licence gate. Widening this is a deliberate act — read docs/LICENSING.md first.
# QRA_ALLOWED_LICENSE_STATUS=["public_domain","permissive"]

# Models (optional — the deterministic half of the system needs none).
#
# Model ids, prices and the role→model policy live in config/models.yaml, not
# here and not in code. Setting any of these keys switches that provider on;
# GET /meta/routing shows which chain each agent role would actually use.
# QRA_ANTHROPIC_API_KEY=sk-ant-...
# QRA_OPENAI_API_KEY=sk-...
# QRA_GOOGLE_API_KEY=...
# QRA_DEEPSEEK_API_KEY=...
# QRA_GROQ_API_KEY=...
# QRA_MISTRAL_API_KEY=...
# QRA_XAI_API_KEY=...
# QRA_TOGETHER_API_KEY=...
# QRA_FIREWORKS_API_KEY=...
# QRA_OPENROUTER_API_KEY=...
# QRA_AZURE_OPENAI_API_KEY=...          # plus a per-deployment base_url in models.yaml
# AWS_ACCESS_KEY_ID / GOOGLE_APPLICATION_CREDENTIALS for bedrock / vertex
#
# Local providers (ollama, vllm, llama.cpp) need no key — they are used when
# reachable. Point them elsewhere by editing base_url in config/models.yaml.
# An institution with its own approved-model list can replace the file wholesale:
# QRA_MODELS_CONFIG=/etc/qra/models.yaml

# Semantic retrieval (optional; disabled and reported as such when unset).
# The value names a provider block under `embedding:` in config/models.yaml.
# QRA_EMBEDDING_PROVIDER=bge_m3_local
# QRA_EMBEDDING_MODEL=BAAI/bge-m3       # optional: pin one of that block's models
#
# Rerank and transcription providers need no setting: the router picks the
# best available, local first, because both send the full text to whoever serves
# them.

# Observability
# QRA_LANGFUSE_PUBLIC_KEY=
# QRA_LANGFUSE_SECRET_KEY=
