# Database
QRA_DATABASE_URL=postgresql+psycopg://qra:qra@localhost:5432/qra
QRA_REDIS_URL=redis://localhost:6379/0

# Licence gate. Widening this is a deliberate act — read docs/LICENSING.md first.
# QRA_ALLOWED_LICENSE_STATUS=["public_domain","permissive"]

# Models (optional — the deterministic half of the system needs none)
# QRA_ANTHROPIC_API_KEY=sk-ant-...
# QRA_OLLAMA_BASE_URL=http://localhost:11434
# QRA_REASONING_MODEL=claude-opus-5
# QRA_FAST_MODEL=claude-haiku-4-5-20251001

# Semantic retrieval (optional; disabled and reported as such when unset)
# QRA_EMBEDDING_PROVIDER=ollama
# QRA_EMBEDDING_MODEL=bge-m3
# QRA_EMBEDDING_BASE_URL=http://localhost:11434
# QRA_EMBEDDING_DIM=1024

# Observability
# QRA_LANGFUSE_PUBLIC_KEY=
# QRA_LANGFUSE_SECRET_KEY=
